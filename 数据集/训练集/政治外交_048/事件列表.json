  {
    "event_id": "D002",
    "doc_id": "D002",
    "event_type": "文件签署",
    "trigger_word": "上海合作组织",
    "argument": {
      "主体": "上海合作组织",
      "地点": "维护和保障地区",
      "内容": "《上海合作组织成立宣言》全面阐明组织宗旨与原则新华社上海6月15日电 六国元首15日在上海签署的《\"上海合作组织\"成立宣言》，全面阐明了这一新型区域合作组织的宗旨、原则、机制和合作领域，为组织的发展奠定了坚实基础。宣言明确规定了上海合作组织的宗旨：加强各成员国之间的相互信任与睦邻友好；鼓励各成员国在政治、经贸、科技、文化、教育、能源、交通、环保及其它领域的有效合作；共同致力于维护和保障地区的和平",
      "影响": "在经济领域，宣言提出，将在上海合作组织框架内启动贸易和投资便利化谈判进程，制定长期多边经贸合作纲要"
    },
