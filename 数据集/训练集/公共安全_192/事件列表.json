  {
    "event_id": "D004",
    "doc_id": "D004",
    "event_type": "成立调查组",
    "trigger_word": "成立",
    "argument": {
      "主体": "调查组由国家安全生产监督管理总局",
      "地点": "北京",
      "内容": "国务院成立事故调查组 全面开展甬温线动车事故调查新华社北京7月28日电 针对甬温线\"7·23\"动车组列车追尾事故，国务院决定成立\"7·23\"甬温线特别重大铁路交通事故调查组，对事故进行全面调查。调查组由国家安全生产监督管理总局主要负责人任组长，监察部、工业和信息化部、铁道部、全国总工会等有关部门和单位以及浙江省人民政府参加，并邀请最高人民检察院派员参加，同时聘请技术、管理等方面专家参与调查工作。",
      "影响": "按照有关规定，调查组坚持\"科学严谨、依法依规、实事求是、注重实效\"的原则，本着对人民群众高度负责的态"
    },
