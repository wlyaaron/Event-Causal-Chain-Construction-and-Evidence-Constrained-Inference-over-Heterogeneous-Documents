  {
    "event_id": "D003",
    "doc_id": "D003",
    "event_type": "事故调查",
    "trigger_word": "认定",
    "argument": {
      "主体": "形成底部",
      "地点": "北京、深圳",
      "内容": "国务院调查组认定深圳\"12·20\"滑坡为特别重大生产安全责任事故新华社北京电 国务院深圳光明新区\"12·20\"滑坡灾害调查组经深入调查取证和技术鉴定，查明了事故发生的经过和原因，认定这起事故是一起受纳场渣土堆填体的滑动，不是山体滑坡，也不属于自然地质灾害，而是一起特别重大生产安全责任事故。调查组查明，事故发生的直接原因是：红坳渣土受纳场没有建设有效的导排水系统，受纳场内积水未能导出排泄，致使堆填",
      "影响": "一些地方重发展、轻安全，对渣土受纳场的安全管理重视不够、监管不力，企业违法违规运营、片面追求经济利益"
    },
    "occur_time": "2015-12-25",
